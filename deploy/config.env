# Here to trigger deploys
CFG_VERSION=1

# Set log levels
# DEBUG=0                    (0=none, 1=steamcmd, 2=rsdw, 3=all)

# If the game breaks (e.g. due to modding or failed update)
# STEAMAPPVALIDATE=0          (0=skip validation, 1=validate game files)

RSDW_PORT=7777
RSDW_SERVER_NAME=StrayDogs
RSDW_WORLD_NAME=Grindville
# RSDW_ADDITIONAL_ARGS=
RSDW_AUTO_STOP_ON_UPDATE=true

# Route EOS SDK HTTPS via the gateway so EOS advertises the gateway's public IP
HTTPS_PROXY=http://egress-proxy:3128
